{
  "name": "home-hospital-platform",
  "version": "0.1.1",
  "private": true,
  "description": "Home Hospital desktop launcher for independent Vaccine and UA Report systems",
  "author": "Home Hospital",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.cjs && node --check preload.cjs && node --check modules.cjs && node --check renderer.js",
    "test": "node --test test/*.test.cjs",
    "verify": "npm run check && npm test",
    "dist:win": "npm run verify && electron-builder --win nsis",
    "release:win": "npm run verify && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "org.homehospital.platform",
    "productName": "Home Hospital Platform",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "modules.cjs",
      "preload.cjs",
      "renderer.js",
      "index.html",
      "styles.css",
      "logo.png",
      "uninstallerIcon.ico",
      "package.json"
    ],
    "win": {
      "icon": "uninstallerIcon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Home Hospital Platform",
      "installerIcon": "uninstallerIcon.ico",
      "uninstallerIcon": "uninstallerIcon.ico"
    },
    "publish": {
      "provider": "github",
      "owner": "MORADOK",
      "repo": "HomeHospitalPlatform",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  }
}
